{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worklog.local/schema/week.schema.json",
  "title": "WorkLog weekly journal",
  "type": "object",
  "required": ["schemaVersion", "week", "startDate", "endDate", "entries", "weeklyReflection"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "weeklyReflection": {
      "type": "object",
      "required": ["highlights", "outcomes", "challenges", "learnings"],
      "properties": {
        "highlights": { "$ref": "#/$defs/stringList" },
        "outcomes": { "$ref": "#/$defs/stringList" },
        "challenges": { "$ref": "#/$defs/stringList" },
        "learnings": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } },
    "reference": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["jira", "link", "document", "other"] },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": ["id", "type", "date", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["meeting", "work", "conversation", "decision", "achievement", "note"] },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "title": { "type": "string" },
        "topics": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "participants": { "$ref": "#/$defs/stringList" },
        "discussion": { "$ref": "#/$defs/stringList" },
        "notes": { "$ref": "#/$defs/stringList" },
        "contribution": { "$ref": "#/$defs/stringList" },
        "decisions": { "$ref": "#/$defs/stringList" },
        "followUps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string" }, "done": { "type": "boolean" }, "reference": { "type": "string" } },
            "additionalProperties": true
          }
        },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "summary": { "type": "string" },
        "details": { "$ref": "#/$defs/stringList" },
        "outcome": { "type": "string" },
        "decision": { "type": "string" },
        "context": { "type": "string" },
        "rationale": { "type": "string" },
        "impact": { "type": "string" },
        "content": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
